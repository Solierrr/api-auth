<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging de api-auth.

  2 destinos:
    * CONSOLE -> dev/local (stdout, já com traceId injetado pelo Spring)
    * OTEL    -> export OTLP dos log records (correlacionados por trace_id/span_id) para o Collector

  O appender OTEL só passa a exportar de fato depois que OpenTelemetryAppenderInitializer roda
  (ApplicationReadyEvent) e chama OpenTelemetryAppender.install(openTelemetry).
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>false</captureExperimentalAttributes>
        <captureCodeAttributes>false</captureCodeAttributes>
        <captureMarkerAttribute>false</captureMarkerAttribute>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>

</configuration>
