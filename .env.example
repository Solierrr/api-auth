# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver "Como rodar local" no README.

# /database (compartilhado com api-core)
DB_POSTGRES_HOST=
DB_POSTGRES_PORT=
DB_POSTGRES_USER=
DB_POSTGRES_PASSWORD=
DB_POSTGRES_AUTH=authdb

# /redis (mesma instância Upstash do api-core, usada pela fila de outbox)
UPSTASH_CORE_HOST=
UPSTASH_CORE_PORT=

# /auth
JWT_ISSUER=solaria-auth
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D
JWT_KEYSTORE_PATH=
JWT_KEYSTORE_PASSWORD=
JWT_ACTIVE_KID=
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
SERVICE_CLIENT_SECRET=

# /service-urls
PERSISTENCE_BASE_URL=http://localhost:8080

# /api-auth (config de negócio da fila de outbox, não é credencial)
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_STREAM_KEY=auth:outbox:user-events
OUTBOX_CONSUMER_GROUP=persistence-user-provisioner
OUTBOX_DLQ_STREAM_KEY=auth:outbox:user-events:dlq
OUTBOX_MAX_DELIVERY_ATTEMPTS=5
OUTBOX_VISIBILITY_TIMEOUT_MS=60000
OUTBOX_RECLAIM_INTERVAL_MS=30000
OUTBOX_CONSUMER_ENABLED=true
