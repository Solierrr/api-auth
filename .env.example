JWT_ISSUER=solaria-auth
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=

DB_URL=jdbc:postgresql://localhost:5432/solaria_auth
DB_USERNAME=postgres
DB_PASSWORD=postgres

# URL base de api-persistence (provisionamento de User via POST /internal/users, sem autenticação)
PERSISTENCE_BASE_URL=http://localhost:8080

# URL do Collector
# dev local -> kubectl port-forward svc/otel-collector 4318:4318 e usar http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Identidade do servico no backend de observabilidade
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
# % de traces amostrados | corte acontece no collector, por isso padrão sempre 1
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
